{
  "name": "circleci-cli-getting-started",
  "version": "1.0.0",
  "description": "Sample project for the CircleCI blog tutorial Getting started with the CircleCI CLI",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pretest": "node -e \"require('node:fs').mkdirSync('test-results', { recursive: true })\"",
    "test": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results/junit.xml",
    "build": "node src/build.js"
  }
}
